{
  "compilerOptions": {
    /* Linguagem alvo */
    "target": "es2020" /* Gera código compatível com Node moderno */,
    "lib": ["ES2020"] /* Inclui as libs da versão escolhida */,

    /* Módulos */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true /* Permite importar arquivos JSON */,
    "esModuleInterop": true /* Suporte a módulos CommonJS (ex: import express from "express") */,
    "forceConsistentCasingInFileNames": true,

    /* Qualidade do código */
    "strict": true /* Ativa todas as verificações estritas */,
    "noUnusedLocals": false /* Erro se variáveis não forem usadas */,
    "noUnusedParameters": false /* Erro se parâmetros não forem usados */,
    "noImplicitReturns": true /* Erro se função não retorna em todos caminhos */,
    "noFallthroughCasesInSwitch": true /* Evita cair em cases de switch sem break */,

    /* Emissão */
    "removeComments": true /* Remove comentários nos .js */,
    "skipLibCheck": true /* Pula checagem de libs (mais rápido) */
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "export"]
}
